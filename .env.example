# SQLite is easiest for local demo. For MySQL, set:
# DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/invoice_chaser
DATABASE_URL=sqlite:///./invoice_chaser.db
SECRET_KEY=change-this-to-a-long-random-secret
APP_TIMEZONE=Asia/Kolkata

# Optional AI message generation (Groq OpenAI-compatible API)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional WhatsApp Cloud API. Without these, reminders are logged as demo messages only.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0
